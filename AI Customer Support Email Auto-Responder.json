    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n\n  // Pull the AI-generated reply text\n  let replyText = \"\";\n  if (item.json.message && item.json.message.content) {\n    replyText = item.json.message.content;\n  } else if (item.json.choices && item.json.choices[0]) {\n    replyText = item.json.choices[0].message.content;\n  } else {\n    replyText = item.json.text || \"\";\n  }\n\n  // Pull original email fields from Node 4\n  const parsed  = $(\"Parse AI Response\").first().json;\n\n  // ── Quality rules ──────────────────────────────────\n  const tooShort    = replyText.trim().length < 50;\n  const tooLong     = replyText.trim().length > 2000;\n  const hasError    = replyText.toLowerCase().includes(\"i cannot\") ||\n                      replyText.toLowerCase().includes(\"i'm sorry, i can't\");\n  const isEmpty     = replyText.trim().length === 0;\n\n  let qualityPassed = true;\n  let qualityNote   = \"Passed\";\n  let finalReply    = replyText.trim();\n\n  if (isEmpty || hasError) {\n    qualityPassed = false;\n    qualityNote   = \"AI reply empty or refused — using fallback\";\n    finalReply    = `Hi there,\\n\\nThank you for reaching out to us. We have received your email regarding \"${parsed.subject}\" and a member of our support team will get back to you within 24 hours.\\n\\nBest regards,\\nSupport Team`;\n  } else if (tooShort) {\n    qualityNote  = \"Reply short but acceptable\";\n  } else if (tooLong) {\n    qualityNote  = \"Reply trimmed to 2000 chars\";\n    finalReply   = finalReply.substring(0, 2000) + \"\\n\\n— Support Team\";\n  }\n\n  const processingTime = new Date().toISOString();\n\n  results.push({\n    json: {\n      // Pass all original fields forward\n      sender_email:   parsed.sender_email,\n      subject:        parsed.subject,\n      email_body:     parsed.email_body,\n      received_at:    parsed.received_at,\n      email_id:       parsed.email_id,\n      run_id:         parsed.run_id,\n      urgency:        parsed.urgency,\n      category:       parsed.category,\n      tone:           parsed.tone,\n      confidence:     parsed.confidence,\n      ai_reason:      parsed.ai_reason,\n      // New fields added by this node\n      final_reply:    finalReply,\n      quality_passed: qualityPassed,\n      quality_note:   qualityNote,\n      processed_at:   processingTime,\n    }\n  });\n}\n\nreturn results;"
      },
