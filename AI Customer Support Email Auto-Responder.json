        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a customer support email classifier. Analyze the email and respond ONLY with valid JSON in this exact format:\n{\n  \"urgency\": \"Critical\" | \"Normal\" | \"Spam\",\n  \"category\": \"Technical\" | \"Billing\" | \"General\" | \"Complaint\" | \"Spam\",\n  \"tone\": \"Frustrated\" | \"Angry\" | \"Neutral\" | \"Curious\" | \"Positive\",\n  \"confidence\": 0.0-1.0,\n  \"reason\": \"one sentence explaining your classification\"\n}\n\nRules:\n- Critical = account locked, data loss, security issue, service down\n- Normal = general questions, feature requests, billing queries\n- Spam = promotions, unsolicited offers, irrelevant content\n- Return ONLY the JSON object. No extra text. No markdown code blocks."
            },
            {
              "content": "=Classify this customer support email:\n\nFROM: {{ $json.sender_email }}\nSUBJECT: {{ $json.subject }}\nBODY: {{ $json.email_body }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 300,
          "textFormat": {
            "textOptions": {
              "type": "text"
            }
          },
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -912,
        -144
      ],
      "id": "958af0ea-5a01-45c5-8d7a-679c9dd71caf",
      "name": "AI Email Classifier",
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const prevData = item.json;\n\n  let aiRaw = \"\";\n\n  // YOUR specific OpenAI node structure: output[0].content[0].text\n  try {\n    if (prevData.output && prevData.output[0] && prevData.output[0].content) {\n      const contentArr = prevData.output[0].content;\n      const textBlock = contentArr.find(c => c.type === \"output_text\" || c.type === \"text\");\n      if (textBlock) aiRaw = textBlock.text || \"\";\n    }\n  } catch(e) {}\n\n  // Fallbacks\n  if (!aiRaw && prevData.message?.content) aiRaw = prevData.message.content;\n  if (!aiRaw && prevData.choices?.[0]) aiRaw = prevData.choices[0].message.content;\n  if (!aiRaw && prevData.content?.[0]?.text) aiRaw = prevData.content[0].text;\n\n  // Debug — remove after fixing\n  console.log(\"aiRaw found:\", aiRaw);\n\n  let parsed = {};\n  try {\n    const cleaned = aiRaw.replace(/```json/g,\"\").replace(/```/g,\"\").trim();\n    parsed = JSON.parse(cleaned);\n  } catch(e) {\n    parsed = {\n      urgency: \"Normal\",\n      category: \"General\", \n      tone: \"Neutral\",\n      confidence: 0,\n      reason: \"Parse failed: \" + aiRaw.substring(0, 100)\n    };\n  }\n\n  const extracted = $(\"Extract Email Data\").first().json;\n\n  results.push({\n    json: {\n      sender_email: extracted.sender_email,\n      subject:      extracted.subject,\n      email_body:   extracted.email_body,\n      received_at:  extracted.received_at,\n      email_id:     extracted.email_id,\n      run_id:       extracted.run_id,\n      urgency:      parsed.urgency    || \"Normal\",\n      category:     parsed.category   || \"General\",\n      tone:         parsed.tone       || \"Neutral\",\n      confidence:   parsed.confidence || 0,\n      ai_reason:    parsed.reason     || \"\",\n    }\n  });\n}\n\nreturn results;"
      },
